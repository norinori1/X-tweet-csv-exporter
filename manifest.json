{
  "manifest_version": 3,
  "name": "X Tweet CSV Exporter (Local)",
  "version": "0.1.0",
  "description": "Export your public X posts to CSV locally. No server, no account, no API key.",
  "permissions": ["storage"],
  "host_permissions": ["https://x.com/*", "https://twitter.com/*"],
  "background": {
    "service_worker": "src/background.js"
  },
  "action": {
    "default_title": "X Tweet CSV Exporter (Local)",
    "default_popup": "popup.html"
  },
  "content_scripts": [
    {
      "matches": ["https://x.com/*", "https://twitter.com/*"],
      "js": ["src/csv.js", "src/parser.js", "src/interceptor.js"],
      "run_at": "document_start",
      "world": "MAIN"
    },
    {
      "matches": ["https://x.com/*", "https://twitter.com/*"],
      "js": ["src/csv-isolated.js", "src/store.js", "src/content.js", "src/panel.js"],
      "css": ["src/panel.css"],
      "run_at": "document_start",
      "world": "ISOLATED"
    }
  ]
}
